# Copy to .env and fill in.

# Notes generation (Claude). https://console.anthropic.com/settings/keys
# Optional if you have a Claude Pro/Max subscription — see LECNOTE_BACKEND.
ANTHROPIC_API_KEY=sk-ant-...

# Speech-to-text (Whisper large-v3). Free tier is generous. Required.
# https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Optional overrides
# LECNOTE_BACKEND=auto     # auto | api | cli
#   api = api.anthropic.com, needs prepaid API credits
#   cli = the `claude` command, billed to a Pro/Max subscription instead
#   auto = try api, fall back to cli when the API balance is empty
# LECNOTE_MODEL=claude-sonnet-5
# LECNOTE_STT_MODEL=whisper-large-v3
# LECNOTE_STT_LANG=en      # "en" transliterates Hindi; "hi" gives Devanagari
